# Supabase connection for the new parallel adapter
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional server-only key for memory writes when Supabase Auth is not yet connected.
# Never expose this value to VITE_* variables or the browser.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
